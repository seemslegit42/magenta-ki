# Bun control plane (default port 1991 — Angular host stays on 3000)
BUN_API_PORT=1991
BUN_API_HOST=0.0.0.0
CORS_ORIGIN=*
EMBED_ORIGIN=http://localhost:3000
GEMINI_API_KEY=

# Phase C: when set, /api/xi/* is proxied to the Go control plane
# GO_API_URL=http://127.0.0.1:8080

# Turso / libSQL (local file default; optional embedded replica)
TURSO_URL=file:./data/lxvos-shell.db
# TURSO_SYNC_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
# TURSO_SYNC_INTERVAL=60

# Local blob store (used when Appwrite is not fully configured)
LOCAL_BLOB_ROOT=./data/blobs

# Appwrite Storage (optional — enables cloud blob backend + virtual folders)
# APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=
# APPWRITE_API_KEY=
# APPWRITE_BUCKET_ID=
